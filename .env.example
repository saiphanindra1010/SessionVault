# SessionVault production / local Next.js env
# Copy to .env.local for `npm run dev`. Set the same vars in Vercel.

SESSIONVAULT_MODE=neon

# Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require

# OpenAI embeddings
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small

# Secrets: generate with `npm run sv:generate-keys` (do not commit real values)
SESSIONVAULT_MASTER_KEY=CHANGE_ME_run_npm_sv_generate_keys
SESSIONVAULT_AUDIT_SALT=CHANGE_ME_run_npm_sv_generate_keys

# Public origin (required). Used for CSRF checks and magic-link URLs.
PUBLIC_URL=http://localhost:3000

# Required in production. Without it, magic links only log to the server console.
RESEND_API_KEY=re_...
SESSIONVAULT_EMAIL_FROM=onboarding@resend.dev

# Optional rate limits (defaults: 60/min, 1000/day)
# SESSIONVAULT_RL_PER_MIN=60
# SESSIONVAULT_RL_PER_DAY=1000
