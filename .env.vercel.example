# SessionVault — Vercel production env
# Set every required var in Vercel > Project > Settings > Environment Variables.

SESSIONVAULT_MODE=neon

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small

SESSIONVAULT_MASTER_KEY=CHANGE_ME_run_pnpm_sv_generate_keys
SESSIONVAULT_AUDIT_SALT=CHANGE_ME_run_pnpm_sv_generate_keys

PUBLIC_URL=https://your-deployment.vercel.app

RESEND_API_KEY=re_...
SESSIONVAULT_EMAIL_FROM=onboarding@resend.dev

# SESSIONVAULT_RL_PER_MIN=60
# SESSIONVAULT_RL_PER_DAY=1000
