{
  "name": "sessionvault",
  "version": "2.0.0",
  "description": "Production MCP SaaS: shared encrypted session memory for AI tools. Next.js + Neon + pgvector.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "sv:generate-keys": "node scripts/generate-keys.mjs",
    "sv:setup-db": "node scripts/setup-db.mjs",
    "sv:create-user": "node scripts/create-user.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "mcp",
    "cursor",
    "claude",
    "memory",
    "session-context",
    "pgvector",
    "neon",
    "vercel",
    "nextjs",
    "saas"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@neondatabase/serverless": "^0.10.4",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
